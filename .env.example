# ThreatLens Environment Variables Template

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=threatlens
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/threatlens

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET=super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Threat Intelligence Providers
URLHAUS_AUTH_KEY=
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# LLM Providers (Optional for enhanced agent summaries)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=info
START_INLINE_CELERY=false

# Frontend Configuration (for Vite)
VITE_API_URL=http://localhost:8000