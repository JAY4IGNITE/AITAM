# Environment Variables for ThreatLens

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=threatlens
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/threatlens

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET=super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers (Optional for development)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Threat Intel Providers (Optional for development)
# VIRUSTOTAL_API_KEY=
# URLHAUS_API_KEY=

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=debug
